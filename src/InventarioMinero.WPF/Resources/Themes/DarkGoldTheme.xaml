<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── PALETA DE COLORES CORPORATIVA: PLANTA MINERA DORADO S.A. ── -->
    <!-- Fondos oscuros profundos -->
    <Color x:Key="ColorBgDeep">#0D1117</Color>
    <Color x:Key="ColorBgMain">#12161E</Color>
    <Color x:Key="ColorBgCard">#1A212B</Color>
    <Color x:Key="ColorBgSurface">#1A212B</Color>
    <Color x:Key="ColorBgCardHover">#222B38</Color>
    <Color x:Key="ColorBgInput">#161C24</Color>
    <Color x:Key="ColorBgInputFocus">#1C232E</Color>

    <!-- Acentos Dorados / Oro Minero -->
    <Color x:Key="ColorGoldPrimary">#E5A93C</Color>
    <Color x:Key="ColorGoldBright">#F5B942</Color>
    <Color x:Key="ColorGoldDark">#B88220</Color>
    <Color x:Key="ColorGoldGlow">#33F5B942</Color>
    <Color x:Key="ColorGoldSubtle">#1AF5B942</Color>

    <!-- Textos -->
    <Color x:Key="ColorTextPrimary">#F0F6FC</Color>
    <Color x:Key="ColorTextSecondary">#9BA3AF</Color>
    <Color x:Key="ColorTextMuted">#656E7B</Color>

    <!-- Bordes -->
    <Color x:Key="ColorBorderSubtle">#2A3442</Color>
    <Color x:Key="ColorBorderInput">#384454</Color>
    <Color x:Key="ColorBorderFocus">#F5B942</Color>

    <!-- Estados -->
    <Color x:Key="ColorSuccess">#2ECC71</Color>
    <Color x:Key="ColorDanger">#E74C3C</Color>
    <Color x:Key="ColorWarning">#F39C12</Color>
    <Color x:Key="ColorInfo">#3498DB</Color>

    <!-- ── SOLID COLOR BRUSHES ── -->
    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}"/>
    <SolidColorBrush x:Key="BrushBgMain" Color="{StaticResource ColorBgMain}"/>
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}"/>
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}"/>
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}"/>
    <SolidColorBrush x:Key="BrushBgInputFocus" Color="{StaticResource ColorBgInputFocus}"/>

    <SolidColorBrush x:Key="BrushGoldPrimary" Color="{StaticResource ColorGoldPrimary}"/>
    <SolidColorBrush x:Key="BrushGoldBright" Color="{StaticResource ColorGoldBright}"/>
    <SolidColorBrush x:Key="BrushGoldDark" Color="{StaticResource ColorGoldDark}"/>
    <SolidColorBrush x:Key="BrushGoldGlow" Color="{StaticResource ColorGoldGlow}"/>
    <SolidColorBrush x:Key="BrushGoldSubtle" Color="{StaticResource ColorGoldSubtle}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="BrushBorderInput" Color="{StaticResource ColorBorderInput}"/>
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource ColorBorderFocus}"/>

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}"/>

    <!-- ── GRADIENT BRUSHES ── -->
    <!-- Gradiente dorado primario de alto impacto para botones y títulos -->
    <LinearGradientBrush x:Key="BrushGoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAD02C" Offset="0.0"/>
        <GradientStop Color="#E5A93C" Offset="0.5"/>
        <GradientStop Color="#C98B1E" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Gradiente dorado para hover -->
    <LinearGradientBrush x:Key="BrushGoldGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE066" Offset="0.0"/>
        <GradientStop Color="#F5B942" Offset="0.5"/>
        <GradientStop Color="#D49228" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Gradiente de fondo de ventana -->
    <LinearGradientBrush x:Key="BrushWindowBgGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#121620" Offset="0.0"/>
        <GradientStop Color="#0B0E14" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
