<Application x:Class="InventarioMinero.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InventarioMinero.WPF"
             xmlns:helpers="clr-namespace:InventarioMinero.WPF.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/DarkGoldTheme.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <helpers:BooleanToActivoConverter x:Key="BooleanToActivoConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
