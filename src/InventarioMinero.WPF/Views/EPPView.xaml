<UserControl x:Class="InventarioMinero.WPF.Views.EPPView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:InventarioMinero.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Loaded="UserControl_Loaded">

    <Grid Margin="24,20">
        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ── CONTENIDO PRINCIPAL: LISTADO Y FILTROS ── -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header con Título y Botón Nuevo -->
                <RowDefinition Height="Auto"/>
                <!-- KPIs Rápidos -->
                <RowDefinition Height="Auto"/>
                <!-- Barra de Búsqueda y Filtros -->
                <RowDefinition Height="Auto"/>
                <!-- Banner de Feedback -->
                <RowDefinition Height="Auto"/>
                <!-- Tabla DataGrid -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── FILA 0: ENCABEZADO ── -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🦺" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Equipos de Protección Personal (EPP)"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Catálogo de seguridad industrial minera, control de tallas, vida útil reglamentaria y stock de reposición"
                               FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="32,2,0,0"/>
                </StackPanel>

                <!-- Botón Nuevo EPP -->
                <Button Grid.Column="1"
                        Style="{StaticResource GoldPrimaryButtonStyle}"
                        Command="{Binding AbrirNuevoCommand}"
                        Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo EPP" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── FILA 1: TARJETAS KPI ── -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DarkCardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL TIPOS DE EPP EN CATÁLOGO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding TotalEPPs}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="STOCK FÍSICO DISPONIBLE EN ALMACÉN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding TotalStockUnidades, StringFormat='{}{0:N0} Und/Par'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource DarkCardStyle}" Padding="16,12" BorderBrush="{StaticResource BrushWarning}">
                    <StackPanel>
                        <TextBlock Text="ALERTAS DE STOCK MÍNIMO / CRÍTICO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}"/>
                        <TextBlock Text="{Binding AlertasStockBajo}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── FILA 2: BARRA DE BÚSQUEDA Y FILTROS ── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Input de búsqueda -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Filtro Categoría -->
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Checkbox solo bajo stock -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Botones de Acción -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Caja de Búsqueda -->
                    <TextBox Grid.Column="0"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="Busqueda_KeyDown"
                             Padding="12,8"
                             Tag="Buscar por código, nombre o talla..."/>

                    <!-- ComboBox Categoría -->
                    <ComboBox Grid.Column="2"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding CategoriaFiltro}"
                              DisplayMemberPath="Nombre"
                              SelectedValuePath="CategoriaId">
                    </ComboBox>

                    <!-- Checkbox Bajo Stock -->
                    <CheckBox Grid.Column="4"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Content="⚠️ Solo Stock Bajo"
                              IsChecked="{Binding SoloBajoStock}"
                              VerticalAlignment="Center"/>

                    <!-- Botones Filtrar y Limpiar -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button Style="{StaticResource DarkSecondaryButtonStyle}"
                                Command="{Binding CargarEPPCommand}"
                                Content="🔍 Buscar"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource DarkSecondaryButtonStyle}"
                                Command="{Binding LimpiarFiltrosCommand}"
                                Content="↺ Limpiar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── FILA 3: MENSAJE DE FEEDBACK ── -->
            <Border Grid.Row="3"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeFeedback, Converter={x:Null}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <SolidColorBrush Color="#1F2A22"/>
                </Border.Background>
                <TextBlock Text="{Binding MensajeFeedback}"
                           Foreground="{StaticResource BrushGoldBright}"
                           FontWeight="SemiBold"
                           FontSize="13"/>
            </Border>

            <!-- ── FILA 4: TABLA DE EPP ── -->
            <Border Grid.Row="4"
                    Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10">
                <DataGrid ItemsSource="{Binding EPPList}"
                          SelectedItem="{Binding EppSeleccionado}"
                          Style="{StaticResource DarkDataGridStyle}">
                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTemplateColumn Header="CÓDIGO" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Codigo}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushGoldBright}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nombre -->
                        <DataGridTemplateColumn Header="EQUIPO DE PROTECCIÓN" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding Marca}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Categoría -->
                        <DataGridTemplateColumn Header="CATEGORÍA" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1C2634"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Categoria.Nombre}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Talla -->
                        <DataGridTemplateColumn Header="TALLA" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Talla, TargetNullValue='N/A'}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Vida Útil -->
                        <DataGridTemplateColumn Header="VIDA ÚTIL" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VidaUtilMeses, StringFormat='{}{0} Meses', TargetNullValue='No aplica'}"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock Mínimo -->
                        <DataGridTemplateColumn Header="STOCK MÍN." Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockMinimo, StringFormat='{}{0:N0}'}"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock Actual -->
                        <DataGridTemplateColumn Header="STOCK ACTUAL" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockActual, StringFormat='{}{0:N0}'}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{StaticResource BrushGoldBright}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource TableActionButtonStyle}"
                                                Command="{Binding DataContext.AbrirEditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Editar EPP">
                                            <TextBlock Text="✏️" FontSize="13"/>
                                        </Button>
                                        <Button Style="{StaticResource TableActionButtonStyle}"
                                                Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Activar / Desactivar">
                                            <TextBlock Text="🔄" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ── MODAL / PANEL LATERAL: CREAR / EDITAR EPP ── -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Background="#99000000"
                Margin="-24,-20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <!-- Tarjeta Modal Centrada -->
                <Border Width="560"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,24">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="35" Opacity="0.7" ShadowDepth="15"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Título del Formulario -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding IsEditMode, Converter={x:Null}}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldBright}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Nuevo Equipo de Protección (EPP)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="Text" Value="Editar Equipo EPP"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Registro reglamentario para dotación y entrega a personal"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource WindowCloseButtonStyle}"
                                    Command="{Binding CancelarFormCommand}"
                                    Width="32" Height="32">
                                <TextBlock Text="✕" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Grid>

                        <!-- Campos en Grid -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CÓDIGO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormCodigo, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsEditMode}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="NOMBRE DEL EPP *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Categoría y Unidad -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CATEGORÍA *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding Categorias}"
                                          SelectedValue="{Binding FormCategoriaId}"
                                          SelectedValuePath="CategoriaId"
                                          DisplayMemberPath="Nombre"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="UNIDAD *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding Unidades}"
                                          SelectedValue="{Binding FormUnidadId}"
                                          SelectedValuePath="UnidadId"
                                          DisplayMemberPath="Nombre"/>
                            </StackPanel>
                        </Grid>

                        <!-- Marca, Talla y Vida Útil -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MARCA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormMarca, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TALLA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormTalla, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="VIDA ÚTIL (MES)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormVidaUtilMeses, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Stock Mínimo y Stock Actual -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STOCK MÍNIMO *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormStockMinimo, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STOCK ACTUAL *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormStockActual, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PRECIO REF. (S/)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormPrecioUnitario, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Descripción Adicional -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="OBSERVACIONES / NORMATIVA DE SEGURIDAD (ANSI / IRAM)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding FormDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                     Height="54"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- Botones Guardar / Cancelar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource GoldPrimaryButtonStyle}"
                                    Command="{Binding GuardarCommand}"
                                    Content="💾 GUARDAR EQUIPO EPP"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource DarkSecondaryButtonStyle}"
                                    Command="{Binding CancelarFormCommand}"
                                    Content="Cancelar"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
