<UserControl x:Class="InventarioMinero.WPF.Views.EntregasEPPView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:InventarioMinero.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EntregasEPPViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <Grid Background="{StaticResource BrushBgMain}">
        <!-- CONTENIDO PRINCIPAL -->
        <DockPanel Margin="28,24">
            <!-- ════ HEADER & KPIS ════ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="SEGURIDAD Y SALUD OCUPACIONAL" 
                                       FontSize="11" FontWeight="Bold" 
                                       Foreground="{StaticResource BrushGoldBright}" 
                                       Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BrushGoldSubtle}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="D.S. 024-2016-EM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Dotación y Entrega de EPP al Personal" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Registro de entrega obligatoria de equipos de protección personal, control de vida útil y cargos firmados" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Botón Acción Principal -->
                    <Button Grid.Column="1"
                            Style="{StaticResource IndustrialPrimaryButton}"
                            Command="{Binding AbrirModalNuevaCommand}"
                            Padding="18,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nueva Dotación de EPP" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- BANNER DE NOTIFICACIÓN -->
                <Border Visibility="{Binding MensajeBanner, Converter={StaticResource NullToVisibilityConverter}}"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A3826"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                    <Setter Property="Background" Value="#381D1D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MensajeBanner}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                        <Setter Property="Foreground" Value="#FFA8A8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- KPI CARDS -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Total Entregas -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🦺" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="TOTAL DOTACIONES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiTotalEntregas}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Cargos de entrega emitidos" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Total Unidades de EPP -->
                    <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushGoldBright}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="📦" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="EPPS DESPACHADOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldBright}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiTotalUnidadesEntregadas, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Unidades entregadas para seguridad" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Trabajadores Dotados -->
                    <Border Grid.Column="4" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="👷" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="TRABAJADORES PROTEGIDOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiTrabajadoresDotados}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="Personal con dotación activa" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ════ BARRA DE FILTROS ════ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Búsqueda rápida -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <TextBox Style="{StaticResource IndustrialTextBox}"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="Busqueda_KeyDown"
                                 Padding="34,8,10,8"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar por código de cargo, trabajador, DNI o EPP entregado..." 
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Botón Refrescar -->
                    <Button Grid.Column="1"
                            Style="{StaticResource IndustrialSecondaryButton}"
                            Command="{Binding CargarEntregasCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ════ TABLA DE ENTREGAS ════ -->
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Entregas}"
                          SelectedItem="{Binding EntregaSeleccionada}"
                          Style="{StaticResource IndustrialDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BrushBorderSubtle}">
                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTemplateColumn Header="N° CARGO" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Numero}" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Fecha -->
                        <DataGridTemplateColumn Header="FECHA ENTREGA" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trabajador -->
                        <DataGridTemplateColumn Header="TRABAJADOR RECEPTOR" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Empleado.NombreCompleto}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="DNI: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding Empleado.DNI}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Empleado.Cargo.Nombre}" FontSize="11" Foreground="{StaticResource BrushGoldBright}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Motivo -->
                        <DataGridTemplateColumn Header="MOTIVO" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#16202B" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Motivo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cantidad de Ítems -->
                        <DataGridTemplateColumn Header="EQUIPOS" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detalles.Count, StringFormat='{}{0} ítem(s)'}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IndustrialPrimaryButton}"
                                            Content="📄 Ver Cargo / Firma"
                                            Padding="10,4"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.VerCargoEntregaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: NUEVA DOTACIÓN DE EPP                         -->
        <!-- ═════════════════════════════════════════════════════════════ -->
        <Grid Background="#B3080B10"
              Visibility="{Binding MostrarModalNueva, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushGoldBright}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="700"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="26">
                <StackPanel>
                    <!-- Header Modal -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="GESTIÓN DE SEGURIDAD INDUSTRIAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Nueva Entrega de EPP a Trabajador" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Content="✕" FontSize="16" Cursor="Hand"
                                Command="{Binding CerrarModalNuevaCommand}"/>
                    </Grid>

                    <!-- Seleccionar Trabajador y Motivo -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Trabajador Minero Receptor *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}"
                                      ItemsSource="{Binding Empleados}"
                                      SelectedItem="{Binding NuevoEmpleado}"
                                      DisplayMemberPath="NombreCompleto"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Motivo de Dotación *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}"
                                      ItemsSource="{Binding Motivos}"
                                      SelectedItem="{Binding NuevoMotivo}"/>
                        </StackPanel>
                    </Grid>

                    <!-- SECCIÓN AGREGAR EPP -->
                    <Border Background="#121822" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AGREGAR ELEMENTO DE PROTECCIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource IndustrialComboBox}"
                                          ItemsSource="{Binding CatalogoEPP}"
                                          SelectedItem="{Binding ItemEPPSeleccionado}"
                                          DisplayMemberPath="Nombre"/>

                                <TextBox Grid.Column="2"
                                         Style="{StaticResource IndustrialTextBox}"
                                         Text="{Binding ItemCantidad, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="4"
                                        Style="{StaticResource IndustrialPrimaryButton}"
                                        Content="➕ Agregar"
                                        Padding="12,7"
                                        Command="{Binding AgregarItemBorradorCommand}"/>
                            </Grid>

                            <!-- Stock disponible aviso -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Stock disponible en almacén: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding StockDisponibleItem, StringFormat='{}{0:N0} unid.'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TABLA ITEMS BORRADOR -->
                    <TextBlock Text="Equipos incluidos en esta entrega:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <Border Background="#0C1017" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" MaxHeight="160">
                        <DataGrid ItemsSource="{Binding ItemsBorrador}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  Foreground="{StaticResource BrushTextPrimary}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="EPP" Binding="{Binding EPP.Nombre}" Width="*"/>
                                <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad, StringFormat='{}{0:N0}'}" Width="60"/>
                                <DataGridTextColumn Header="P. UNIT." Binding="{Binding PrecioUnitario, StringFormat='{}S/ {0:N2}'}" Width="80"/>
                                <DataGridTextColumn Header="VENCE APROX." Binding="{Binding FechaVencimiento, StringFormat='{}{0:MM/yyyy}'}" Width="100"/>
                                <DataGridTemplateColumn Header="QUITAR" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" 
                                                    Background="Transparent" BorderThickness="0" 
                                                    Foreground="{StaticResource BrushDanger}" 
                                                    FontWeight="Bold" Cursor="Hand"
                                                    Command="{Binding DataContext.EliminarItemBorradorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Observaciones -->
                    <TextBlock Text="Observaciones / Justificación de Seguridad" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,4"/>
                    <TextBox Style="{StaticResource IndustrialTextBox}" 
                             Text="{Binding NuevasObservaciones, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,16"/>

                    <!-- Botones Acción -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IndustrialSecondaryButton}"
                                Content="Cancelar"
                                Command="{Binding CerrarModalNuevaCommand}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource IndustrialPrimaryButton}"
                                Content="Confirmar Entrega y Descargar Stock"
                                Command="{Binding GuardarEntregaCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: ACTA DE ENTREGA DE EPP (FORMATO IMPRIMIBLE)    -->
        <!-- ═════════════════════════════════════════════════════════════ -->
        <Grid Background="#B3080B10"
              Visibility="{Binding MostrarModalImpresion, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushGoldBright}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="750" MaxHeight="780"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <DockPanel>
                    <!-- Header Modal con Botón Imprimir -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="DOCUMENTO OFICIAL DE CONTROL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Cargo de Recepción y Entrega de EPP" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IndustrialPrimaryButton}"
                                    Padding="14,6" Margin="0,0,10,0"
                                    Click="BtnImprimir_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖨️" Margin="0,0,6,0"/>
                                    <TextBlock Text="Imprimir / PDF" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    Content="✕" FontSize="16" Cursor="Hand"
                                    Command="{Binding CerrarModalImpresionCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- HOJA IMPRIMIBLE (DOCUMENTO A4 CORPORATIVO) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border x:Name="HojaCargoImprimible"
                                Background="#FFFFFF"
                                CornerRadius="4"
                                Padding="36"
                                Margin="0,4,0,0">
                            <StackPanel TextElement.Foreground="#1A1A1A" TextElement.FontFamily="Segoe UI">
                                <!-- MEMBRETE -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PLANTA MINERA DORADO S.A." FontSize="18" FontWeight="Bold" Foreground="#8C6314"/>
                                        <TextBlock Text="ÁREA DE SEGURIDAD Y ALMACÉN GENERAL" FontSize="11" FontWeight="SemiBold" Foreground="#555555"/>
                                        <TextBlock Text="Cumplimiento D.S. N° 024-2016-EM - Reglamento de Seguridad Minera" FontSize="9" Foreground="#777777"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" BorderBrush="#8C6314" BorderThickness="1.5" Padding="12,8" CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="ACTA DE ENTREGA DE EPP" FontSize="11" FontWeight="Bold" Foreground="#8C6314" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding EntregaSeleccionada.Numero}" FontSize="13" FontWeight="Bold" Foreground="#111111" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Separator Background="#8C6314" Margin="0,0,0,16"/>

                                <!-- DATOS DEL TRABAJADOR Y FECHA -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DATOS DEL TRABAJADOR:" FontWeight="Bold" FontSize="11" Foreground="#444444" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding EntregaSeleccionada.Empleado.NombreCompleto}" FontWeight="Bold" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="DNI: " FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="{Binding EntregaSeleccionada.Empleado.DNI}" FontSize="11" Margin="0,0,12,0"/>
                                            <TextBlock Text="Cargo: " FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="{Binding EntregaSeleccionada.Empleado.Cargo.Nombre}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="FECHA DE EMISIÓN:" FontWeight="Bold" FontSize="11" Foreground="#444444" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding EntregaSeleccionada.Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontWeight="Bold" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Motivo: " FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="{Binding EntregaSeleccionada.Motivo}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- TABLA DE DETALLES -->
                                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,16">
                                    <DataGrid ItemsSource="{Binding EntregaSeleccionada.Detalles}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="#EEEEEE"
                                              VerticalGridLinesBrush="#EEEEEE"
                                              Background="#FFFFFF"
                                              Foreground="#111111"
                                              RowBackground="#FFFFFF"
                                              AlternatingRowBackground="#F9F9F9">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding EPP.Codigo}" Width="80"/>
                                            <DataGridTextColumn Header="DESCRIPCIÓN DEL EQUIPO DE PROTECCIÓN" Binding="{Binding EPP.Nombre}" Width="*"/>
                                            <DataGridTextColumn Header="TALLA" Binding="{Binding EPP.Talla, TargetNullValue='STD'}" Width="60"/>
                                            <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad, StringFormat='{}{0:N0}'}" Width="60"/>
                                            <DataGridTextColumn Header="RENOVAR EN" Binding="{Binding FechaVencimiento, StringFormat='{}{0:MM/yyyy}'}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- COMPROMISO LEGAL Y SEGURIDAD -->
                                <Border Background="#F4F4F4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,32">
                                    <TextBlock FontSize="9" TextWrapping="Wrap" Foreground="#555555" LineHeight="14">
                                        <Run FontWeight="Bold" Text="DECLARACIÓN Y COMPROMISO DEL TRABAJADOR: "/>
                                        <Run Text="Declaro haber recibido en óptimas condiciones y libre de defectos los Equipos de Protección Personal (EPP) arriba detallados, comprometiéndome a darles un uso correcto y exclusivo para las labores asignadas en Planta Minera Dorado S.A., manteniéndolos limpios e informando oportunamente cualquier deterioro para su reposición inmediata, conforme a los Arts. 95, 96 y 97 del Reglamento de Seguridad y Salud Ocupacional en Minería D.S. 024-2016-EM."/>
                                    </TextBlock>
                                </Border>

                                <!-- FIRMAS -->
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Firma Trabajador -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Width="200" Margin="0,0,0,6"/>
                                        <TextBlock Text="FIRMA DEL TRABAJADOR" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EntregaSeleccionada.Empleado.NombreCompleto}" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EntregaSeleccionada.Empleado.DNI, StringFormat='{}DNI: {0}'}" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Firma Almacenero / Seguridad -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Width="200" Margin="0,0,0,6"/>
                                        <TextBlock Text="ENTREGADO POR ALMACÉN" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EntregaSeleccionada.Usuario.NombreUsuario, StringFormat='{}Usuario: {0}'}" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Seguridad y Control de Inventario" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
