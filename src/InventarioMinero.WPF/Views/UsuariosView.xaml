<UserControl x:Class="InventarioMinero.WPF.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:InventarioMinero.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:UsuariosViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <Grid Background="{StaticResource BrushBgMain}">
        <!-- CONTENIDO PRINCIPAL -->
        <DockPanel Margin="28,24">
            <!-- ════ HEADER & KPIS ════ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="SEGURIDAD Y ACCESOS" 
                                       FontSize="11" FontWeight="Bold" 
                                       Foreground="{StaticResource BrushGoldBright}" 
                                       Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BrushGoldSubtle}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="CONTROL DE USUARIOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Cuentas de Usuario y Roles del Sistema" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Administración de credenciales, roles de acceso a terminales LAN y permisos de operación" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Botón Acción Principal -->
                    <Button Grid.Column="1"
                            Style="{StaticResource IndustrialPrimaryButton}"
                            Command="{Binding AbrirModalNuevoCommand}"
                            Padding="18,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nueva Cuenta de Usuario" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- BANNER DE NOTIFICACIÓN -->
                <Border Visibility="{Binding MensajeBanner, Converter={StaticResource NullToVisibilityConverter}}"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A3826"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                    <Setter Property="Background" Value="#381D1D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MensajeBanner}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                        <Setter Property="Foreground" Value="#FFA8A8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- KPI CARDS -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Total Cuentas -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🔐" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="TOTAL CUENTAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiTotalUsuarios}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Usuarios registrados en el sistema" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Cuentas Activas -->
                    <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="✅" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="CUENTAS ACTIVAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiUsuariosActivos}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="Habilitadas para iniciar sesión" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Administradores -->
                    <Border Grid.Column="4" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushGoldBright}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⭐" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="ADMINISTRADORES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldBright}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiAdministradores}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Acceso total y configuración" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ════ BARRA DE FILTROS ════ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Búsqueda rápida -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <TextBox Style="{StaticResource IndustrialTextBox}"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="Busqueda_KeyDown"
                                 Padding="34,8,10,8"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar por nombre de usuario, trabajador o rol..." 
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Botón Refrescar -->
                    <Button Grid.Column="1"
                            Style="{StaticResource IndustrialSecondaryButton}"
                            Command="{Binding CargarUsuariosCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ════ TABLA DE USUARIOS ════ -->
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Usuarios}"
                          SelectedItem="{Binding UsuarioSeleccionado}"
                          Style="{StaticResource IndustrialDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BrushBorderSubtle}">
                    <DataGrid.Columns>
                        <!-- Usuario -->
                        <DataGridTemplateColumn Header="USUARIO" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreUsuario}" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trabajador Vinculado -->
                        <DataGridTemplateColumn Header="TRABAJADOR ASOCIADO" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Empleado.NombreCompleto, TargetNullValue='Sin Asignar'}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="DNI: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding Empleado.DNI, TargetNullValue='-'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Empleado.Cargo.Nombre, TargetNullValue=''}" FontSize="11" Foreground="{StaticResource BrushGoldBright}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Rol -->
                        <DataGridTemplateColumn Header="ROL DE ACCESO" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#16202B" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Rol.Nombre, TargetNullValue='Usuario'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushGoldBright}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Último Acceso -->
                        <DataGridTemplateColumn Header="ÚLTIMO ACCESO" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UltimoAcceso, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='Nunca'}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Estado -->
                        <DataGridTemplateColumn Header="ESTADO" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#172F1F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Background" Value="#381717"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Activo, Converter={StaticResource BooleanToActivoConverter}}" FontWeight="Bold" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IndustrialSecondaryButton}"
                                                Content="🔑 Clave"
                                                ToolTip="Cambiar o restablecer contraseña"
                                                Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding DataContext.AbrirModalPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource IndustrialSecondaryButton}"
                                                Content="🔄"
                                                ToolTip="Activar o desactivar cuenta"
                                                Padding="6,3" FontSize="11"
                                                Command="{Binding DataContext.AlternarEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: NUEVO USUARIO                                 -->
        <!-- ═════════════════════════════════════════════════════════════ -->
        <Border Background="#B3080B10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarModalNuevo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushGoldBright}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="26">
                <StackPanel>
                    <!-- Header Modal -->
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="SEGURIDAD Y CONTROL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Crear Nueva Cuenta de Usuario" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Content="✕" FontSize="16" Cursor="Hand"
                                Command="{Binding CerrarModalNuevoCommand}"/>
                    </Grid>

                    <!-- Seleccionar Trabajador -->
                    <TextBlock Text="Trabajador de Planta Vinculado *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}"
                              ItemsSource="{Binding Empleados}"
                              SelectedItem="{Binding NuevoEmpleado}"
                              DisplayMemberPath="NombreCompleto"
                              Margin="0,0,0,14"/>

                    <!-- Nombre de Usuario y Rol -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre de Usuario *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding NuevoUsername, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rol de Acceso *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}"
                                      ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding NuevoRol}"
                                      DisplayMemberPath="Nombre"/>
                        </StackPanel>
                    </Grid>

                    <!-- Contraseña Inicial -->
                    <TextBlock Text="Contraseña Inicial *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource IndustrialTextBox}" 
                             Text="{Binding NuevoPassword, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,22"/>

                    <!-- Botones Acción -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IndustrialSecondaryButton}"
                                Content="Cancelar"
                                Command="{Binding CerrarModalNuevoCommand}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource IndustrialPrimaryButton}"
                                Content="Crear Usuario"
                                Command="{Binding GuardarNuevoUsuarioCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: CAMBIAR / RESETEAR CONTRASEÑA                 -->
        <!-- ═════════════════════════════════════════════════════════════ -->
        <Border Background="#B3080B10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarModalPassword}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushGoldBright}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="26">
                <StackPanel>
                    <!-- Header Modal -->
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="SEGURIDAD DE ACCESO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Restablecer Contraseña" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Content="✕" FontSize="16" Cursor="Hand"
                                Command="{Binding CerrarModalPasswordCommand}"/>
                    </Grid>

                    <Border Background="#16202B" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Usuario: " FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding UsuarioPasswordTarget.NombreUsuario}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nueva Contraseña -->
                    <TextBlock Text="Nueva Contraseña (mínimo 4 caracteres) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource IndustrialTextBox}" 
                             Text="{Binding NuevoPasswordReset, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,22"/>

                    <!-- Botones Acción -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IndustrialSecondaryButton}"
                                Content="Cancelar"
                                Command="{Binding CerrarModalPasswordCommand}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource IndustrialPrimaryButton}"
                                Content="Guardar Clave"
                                Command="{Binding GuardarCambioPasswordCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
