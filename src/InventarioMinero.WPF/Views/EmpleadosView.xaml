<UserControl x:Class="InventarioMinero.WPF.Views.EmpleadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:InventarioMinero.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EmpleadosViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <Grid Background="{StaticResource BrushBgMain}">
        <!-- CONTENIDO PRINCIPAL -->
        <DockPanel Margin="28,24">
            <!-- ════ HEADER & KPIS ════ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="RECURSOS HUMANOS" 
                                       FontSize="11" FontWeight="Bold" 
                                       Foreground="{StaticResource BrushGoldBright}" 
                                       Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BrushGoldSubtle}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="PLANTA &amp; MINA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Padrón de Personal Minero y Cargos" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Registro oficial de operarios, supervisores, cargos de mina y custodios de equipos" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Botón Acción Principal -->
                    <Button Grid.Column="1"
                            Style="{StaticResource IndustrialPrimaryButton}"
                            Command="{Binding AbrirModalNuevoCommand}"
                            Padding="18,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nuevo Trabajador" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- BANNER DE NOTIFICACIÓN -->
                <Border Visibility="{Binding MensajeBanner, Converter={StaticResource NullToVisibilityConverter}}"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A3826"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                    <Setter Property="Background" Value="#381D1D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MensajeBanner}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                        <Setter Property="Foreground" Value="#FFA8A8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- KPI CARDS -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Total Personal -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="👥" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="TOTAL PERSONAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiTotalPersonal}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Trabajadores en planilla y contratistas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Personal Activo -->
                    <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="✅" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="PERSONAL ACTIVO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiPersonalActivo}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="Habilitados para despacho y labores" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Cargos Operativos -->
                    <Border Grid.Column="4" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushGoldBright}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⛏️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="CARGOS MINEROS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldBright}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiTotalCargos}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Ocupaciones y roles operativos" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ════ BARRA DE FILTROS ════ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Búsqueda rápida -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <TextBox Style="{StaticResource IndustrialTextBox}"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="Busqueda_KeyDown"
                                 Padding="34,8,10,8"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar por código, nombres, DNI o área..." 
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Filtro por Cargo -->
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource IndustrialComboBox}"
                              ItemsSource="{Binding Cargos}"
                              SelectedItem="{Binding CargoFiltro}"
                              DisplayMemberPath="Nombre"
                              Margin="0,0,14,0"/>

                    <!-- Checkbox solo activos -->
                    <CheckBox Grid.Column="2" 
                              Content="Solo Activos" 
                              IsChecked="{Binding SoloActivos}" 
                              Foreground="{StaticResource BrushTextSecondary}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Command="{Binding CargarEmpleadosCommand}"/>

                    <!-- Botón Refrescar -->
                    <Button Grid.Column="3"
                            Style="{StaticResource IndustrialSecondaryButton}"
                            Command="{Binding CargarEmpleadosCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ════ TABLA DE EMPLEADOS ════ -->
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Empleados}"
                          SelectedItem="{Binding EmpleadoSeleccionado}"
                          Style="{StaticResource IndustrialDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BrushBorderSubtle}">
                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTemplateColumn Header="CÓDIGO" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Codigo}" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- DNI -->
                        <DataGridTemplateColumn Header="DNI" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DNI}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nombre Completo -->
                        <DataGridTemplateColumn Header="APELLIDOS Y NOMBRES" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreCompleto}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cargo -->
                        <DataGridTemplateColumn Header="CARGO / OCUPACIÓN" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#16202B" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Cargo.Nombre}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushGoldBright}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Área -->
                        <DataGridTemplateColumn Header="ÁREA DE TRABAJO" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Area, TargetNullValue='General'}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Estado -->
                        <DataGridTemplateColumn Header="ESTADO" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#172F1F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Background" Value="#381717"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Activo, Converter={StaticResource BooleanToActivoConverter}}" FontWeight="Bold" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IndustrialSecondaryButton}"
                                                Content="✏️ Editar"
                                                Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding DataContext.AbrirModalEditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource IndustrialSecondaryButton}"
                                                Content="🔄"
                                                ToolTip="Cambiar Estado"
                                                Padding="6,3" FontSize="11"
                                                Command="{Binding DataContext.AlternarEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: REGISTRO / EDICIÓN DE EMPLEADO                -->
        <!-- ═════════════════════════════════════════════════════════════ -->
        <Border Background="#B3080B10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarModal}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushGoldBright}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="26">
                <StackPanel>
                    <!-- Header Modal -->
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="GESTIÓN DE PERSONAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Ficha de Trabajador Minero" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Content="✕" FontSize="16" Cursor="Hand"
                                Command="{Binding CerrarModalCommand}"/>
                    </Grid>

                    <!-- Código y DNI -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Código *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding FormCodigo}" IsReadOnly="True" Background="#16202B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DNI (8 dígitos) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding FormDNI, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Nombres y Apellidos -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombres *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding FormNombres, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Apellidos *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding FormApellidos, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Cargo y Área -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cargo Minero *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}"
                                      ItemsSource="{Binding Cargos}"
                                      SelectedItem="{Binding FormCargo}"
                                      DisplayMemberPath="Nombre"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Área / Guardia" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding FormArea, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Teléfono y Correo -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Teléfono de Contacto" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding FormTelefono, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email Corporativo" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Botones Acción -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IndustrialSecondaryButton}"
                                Content="Cancelar"
                                Command="{Binding CerrarModalCommand}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource IndustrialPrimaryButton}"
                                Content="Guardar Trabajador"
                                Command="{Binding GuardarEmpleadoCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
