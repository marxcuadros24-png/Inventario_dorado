<UserControl x:Class="InventarioMinero.WPF.Views.MovimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:InventarioMinero.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <Grid Margin="24,20">
        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ── CONTENIDO PRINCIPAL: LISTA DE MOVIMIENTOS ── -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header con Título y Botón Nuevo -->
                <RowDefinition Height="Auto"/>
                <!-- KPIs Rápidos -->
                <RowDefinition Height="Auto"/>
                <!-- Barra de Búsqueda y Filtros -->
                <RowDefinition Height="Auto"/>
                <!-- Banner Feedback -->
                <RowDefinition Height="Auto"/>
                <!-- DataGrid de Movimientos -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── FILA 0: ENCABEZADO ── -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Movimientos de Almacén y Kárdex"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Registro de ingresos por compra, egresos por consumo, control de documentos y auditoría de stock"
                               FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="32,2,0,0"/>
                </StackPanel>

                <!-- Botón Registrar Movimiento -->
                <Button Grid.Column="1"
                        Style="{StaticResource GoldPrimaryButtonStyle}"
                        Command="{Binding AbrirNuevoCommand}"
                        Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Registrar Movimiento" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── FILA 1: TARJETAS KPI ── -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DarkCardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL OPERACIONES REGISTRADAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding TotalMovimientos}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="ENTRADAS / INGRESOS POR COMPRA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding TotalEntradas}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource DarkCardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="SALIDAS POR CONSUMO A OPERACIÓN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding TotalSalidas}" FontSize="24" FontWeight="Bold" Foreground="#3498DB" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── FILA 2: BARRA DE BÚSQUEDA Y FILTROS ── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Búsqueda -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Tipo Movimiento -->
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Botones -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="Busqueda_KeyDown"
                             Padding="12,8"
                             Tag="Buscar por número (MOV-...), factura, guía o herramienta..."/>

                    <ComboBox Grid.Column="2"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding TiposMovimiento}"
                              SelectedItem="{Binding TipoFiltro}"
                              DisplayMemberPath="Nombre"
                              SelectedValuePath="TipoMovId"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Style="{StaticResource DarkSecondaryButtonStyle}"
                                Command="{Binding CargarMovimientosCommand}"
                                Content="🔍 Buscar"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource DarkSecondaryButtonStyle}"
                                Command="{Binding LimpiarFiltrosCommand}"
                                Content="↺ Limpiar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── FILA 3: MENSAJE FEEDBACK ── -->
            <Border Grid.Row="3"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeFeedback, Converter={x:Null}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <SolidColorBrush Color="#1F2A22"/>
                </Border.Background>
                <TextBlock Text="{Binding MensajeFeedback}"
                           Foreground="{StaticResource BrushGoldBright}"
                           FontWeight="SemiBold"
                           FontSize="13"/>
            </Border>

            <!-- ── FILA 4: TABLA DATAGRID ── -->
            <Border Grid.Row="4"
                    Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10">
                <DataGrid ItemsSource="{Binding Movimientos}"
                          SelectedItem="{Binding MovimientoSeleccionado}"
                          Style="{StaticResource DarkDataGridStyle}">
                    <DataGrid.Columns>
                        <!-- Número Movimiento -->
                        <DataGridTemplateColumn Header="NÚMERO" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Numero}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushGoldBright}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Fecha y Hora -->
                        <DataGridTemplateColumn Header="FECHA / HORA" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tipo de Movimiento (Chip Verde o Azul) -->
                        <DataGridTemplateColumn Header="TIPO DE MOVIMIENTO" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C2E20"/>
                                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TipoMovimiento.EsEntrada}" Value="False">
                                                        <Setter Property="Background" Value="#192534"/>
                                                        <Setter Property="BorderBrush" Value="#3498DB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TipoMovimiento.Nombre}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Documento de Referencia -->
                        <DataGridTemplateColumn Header="DOC. REFERENCIA" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DocumentoRef, TargetNullValue='Sin documento'}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Responsable -->
                        <DataGridTemplateColumn Header="RESPONSABLE" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Usuario.Empleado.NombreCompleto, TargetNullValue='Almacenero'}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cantidad Artículos -->
                        <DataGridTemplateColumn Header="ÍTEMS" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detalles.Count, StringFormat='{}{0} ítem(s)'}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Estado -->
                        <DataGridTemplateColumn Header="ESTADO" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C2E20"/>
                                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Anulado">
                                                        <Setter Property="Background" Value="#341A1A"/>
                                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Estado}"
                                                   FontSize="11"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Anulado">
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource TableActionButtonStyle}"
                                                Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Ver Detalle de Ítems">
                                            <TextBlock Text="🔍" FontSize="13"/>
                                        </Button>
                                        <Button Style="{StaticResource TableActionButtonStyle}"
                                                Command="{Binding DataContext.AnularCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Anular Movimiento y Revertir Stock">
                                            <TextBlock Text="❌" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ── MODAL: REGISTRAR NUEVO MOVIMIENTO DE ALMACÉN ── -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Background="#B3000000"
                Margin="-24,-20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNuevoMovimientoOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <!-- Tarjeta Modal -->
                <Border Width="680"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,24">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="35" Opacity="0.7" ShadowDepth="15"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Título -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Registrar Movimiento de Almacén"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldBright}"/>
                                <TextBlock Text="Entrada por compra o salida de herramientas con actualización inmediata de stock"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource WindowCloseButtonStyle}"
                                    Command="{Binding CancelarNuevoCommand}"
                                    Width="32" Height="32">
                                <TextBlock Text="✕" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Grid>

                        <!-- Cabecera del Movimiento -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TIPO DE OPERACIÓN *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding TiposMovimiento}"
                                          SelectedValue="{Binding FormTipoMovId}"
                                          SelectedValuePath="TipoMovId"
                                          DisplayMemberPath="Nombre"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DOC. REFERENCIA (FACTURA / GUÍA)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormDocumentoRef, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Requerimiento Asociado (Opcional) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VINCULAR REQUERIMIENTO DE COMPRA (OPCIONAL)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding RequerimientosPendientes}"
                                          SelectedValue="{Binding FormRequerimientoId}"
                                          SelectedValuePath="RequerimientoId"
                                          DisplayMemberPath="Numero"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OBSERVACIONES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding FormObservaciones, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sub-sección: Agregar Herramientas al Borrador -->
                        <Border Background="#141922"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="AGREGAR HERRAMIENTAS AL MOVIMIENTO"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldBright}"
                                           Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selector Herramienta -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="HERRAMIENTA" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                                  ItemsSource="{Binding CatalogoHerramientas}"
                                                  SelectedItem="{Binding ItemHerramientaSeleccionada}"
                                                  DisplayMemberPath="Nombre"/>
                                    </StackPanel>

                                    <!-- Cantidad -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CANTIDAD" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                 Text="{Binding ItemCantidad, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Precio Unitario -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PRECIO (S/)" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                 Text="{Binding ItemPrecioUnitario, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Botón Agregar -->
                                    <Button Grid.Column="6"
                                            Style="{StaticResource GoldPrimaryButtonStyle}"
                                            Command="{Binding AgregarItemBorradorCommand}"
                                            Content="+ Agregar"
                                            Padding="14,9"
                                            VerticalAlignment="Bottom"/>
                                </Grid>

                                <!-- Lista de Ítems en el Borrador -->
                                <Border Background="#10141B" BorderBrush="#252F3E" BorderThickness="1" CornerRadius="6" MaxHeight="140">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ItemsBorrador}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#1C2430" BorderThickness="0,0,0,1" Padding="10,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding Herramienta.Nombre}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Cantidad, StringFormat='{}{0:N0} Und'}" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PrecioUnitario, StringFormat='{}S/ {0:N2}'}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat='{}S/ {0:N2}'}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                            <Button Grid.Column="4"
                                                                    Style="{StaticResource TableActionButtonStyle}"
                                                                    Command="{Binding DataContext.EliminarItemBorradorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Quitar">
                                                                <TextBlock Text="✕" FontSize="11" Foreground="#E74C3C"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Total General del Borrador -->
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="TOTAL ESTIMADO DEL MOVIMIENTO:"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalBorrador, StringFormat='{}S/ {0:N2}'}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushGoldBright}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Botones Confirmar / Cancelar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource GoldPrimaryButtonStyle}"
                                    Command="{Binding GuardarMovimientoCommand}"
                                    Content="💾 CONFIRMAR Y REGISTRAR EN ALMACÉN"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource DarkSecondaryButtonStyle}"
                                    Command="{Binding CancelarNuevoCommand}"
                                    Content="Cancelar"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ── MODAL: VER DETALLE DEL MOVIMIENTO ── -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Background="#B3000000"
                Margin="-24,-20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetalleModalOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Border Width="640"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,24">
                    <StackPanel>
                        <!-- Header Detalle -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding MovimientoSeleccionado.Numero, StringFormat='{}Detalle de Operación: {0}'}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldBright}"/>
                                <TextBlock Text="{Binding MovimientoSeleccionado.Fecha, StringFormat='{}Registrado el {0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource WindowCloseButtonStyle}"
                                    Command="{Binding CerrarDetalleCommand}"
                                    Width="32" Height="32">
                                <TextBlock Text="✕" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Grid>

                        <!-- Datos del Movimiento -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding MovimientoSeleccionado.TipoMovimiento.Nombre, StringFormat='{}Tipo: {0}'}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding MovimientoSeleccionado.DocumentoRef, StringFormat='{}Doc. Ref: {0}', TargetNullValue='Doc. Ref: Sin documento'}" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding MovimientoSeleccionado.Usuario.Empleado.NombreCompleto, StringFormat='{}Responsable: {0}'}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding MovimientoSeleccionado.Estado, StringFormat='{}Estado: {0}'}" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tabla de Ítems en el Detalle -->
                        <TextBlock Text="HERRAMIENTAS INVOLUCRADAS:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <Border Background="#10141B" BorderBrush="#252F3E" BorderThickness="1" CornerRadius="6" Margin="0,0,0,20">
                            <ItemsControl ItemsSource="{Binding MovimientoSeleccionado.Detalles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1C2430" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Herramienta.Codigo}" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Herramienta.Nombre}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Cantidad, StringFormat='{}{0:N0} Und'}" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PrecioUnitario, StringFormat='{}S/ {0:N2}'}" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat='{}S/ {0:N2}'}" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Style="{StaticResource DarkSecondaryButtonStyle}"
                                Command="{Binding CerrarDetalleCommand}"
                                Content="Cerrar Detalle"
                                HorizontalAlignment="Right"
                                Padding="18,8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
