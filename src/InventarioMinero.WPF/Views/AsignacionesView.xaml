<UserControl x:Class="InventarioMinero.WPF.Views.AsignacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:InventarioMinero.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AsignacionesViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <Grid Background="{StaticResource BrushBgMain}">
        <!-- CONTENIDO PRINCIPAL -->
        <DockPanel Margin="28,24">
            <!-- ════ HEADER & KPIS ════ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CONTROL DE HERRAMIENTAS" 
                                       FontSize="11" FontWeight="Bold" 
                                       Foreground="{StaticResource BrushGoldBright}" 
                                       Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BrushGoldSubtle}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="PAÑOL Y CUSTODIA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Préstamos y Asignaciones al Personal Minero" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Seguimiento de herramientas entregadas en guardia, retornos, pérdidas y estado físico" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Botón Acción Principal -->
                    <Button Grid.Column="1"
                            Style="{StaticResource IndustrialPrimaryButton}"
                            Command="{Binding AbrirModalNuevoCommand}"
                            Padding="18,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nuevo Préstamo de Herramienta" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- BANNER DE NOTIFICACIÓN -->
                <Border Visibility="{Binding MensajeBanner, Converter={StaticResource NullToVisibilityConverter}}"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A3826"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                    <Setter Property="Background" Value="#381D1D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MensajeBanner}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsErrorBanner}" Value="True">
                                        <Setter Property="Foreground" Value="#FFA8A8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- KPI CARDS -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Préstamos Activos -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🛠️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="PRÉSTAMOS ACTIVOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiPrestamosActivos}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="En poder del personal en mina" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Préstamos Vencidos (Alerta) -->
                    <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="PRÉSTAMOS VENCIDOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushDanger}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiPrestamosVencidos}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushDanger}"/>
                            <TextBlock Text="Superaron fecha programada de retorno" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Devoluciones del Día -->
                    <Border Grid.Column="4" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="✅" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="DEVUELTOS HOY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiDevueltosHoy}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="Reingresados al pañol hoy" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Trabajadores Custodios -->
                    <Border Grid.Column="6" Background="{StaticResource BrushBgSurface}" 
                            BorderBrush="{StaticResource BrushGoldBright}" BorderThickness="1" 
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="👷" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="TRABAJADORES CUSTODIOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldBright}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiTrabajadoresConPrestamos}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Personal con custodia asignada" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ════ BARRA DE FILTROS ════ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Búsqueda rápida -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <TextBox Style="{StaticResource IndustrialTextBox}"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="Busqueda_KeyDown"
                                 Padding="34,8,10,8"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar por código de asignación, herramienta, DNI o trabajador..." 
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Filtro solo vencidas -->
                    <CheckBox Grid.Column="1" 
                              Content="⚠️ Solo Préstamos Vencidos" 
                              IsChecked="{Binding SoloVencidas}" 
                              Foreground="{StaticResource BrushTextSecondary}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Command="{Binding CargarAsignacionesCommand}"/>

                    <!-- Botón Refrescar -->
                    <Button Grid.Column="2"
                            Style="{StaticResource IndustrialSecondaryButton}"
                            Command="{Binding CargarAsignacionesCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ════ TABLA DE ASIGNACIONES ════ -->
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Asignaciones}"
                          SelectedItem="{Binding AsignacionSeleccionada}"
                          Style="{StaticResource IndustrialDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BrushBorderSubtle}">
                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTemplateColumn Header="N° REGISTRO" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Numero}" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Herramienta -->
                        <DataGridTemplateColumn Header="HERRAMIENTA PRESTADA" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Herramienta.Nombre}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Herramienta.Codigo}" FontSize="11" Foreground="{StaticResource BrushGoldBright}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Herramienta.Marca, TargetNullValue=''}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trabajador Responsable -->
                        <DataGridTemplateColumn Header="TRABAJADOR RESPONSABLE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Empleado.NombreCompleto}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="DNI: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding Empleado.DNI}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Empleado.Cargo.Nombre}" FontSize="11" Foreground="{StaticResource BrushGoldBright}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cantidad -->
                        <DataGridTemplateColumn Header="CANT." Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cantidad, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Fechas -->
                        <DataGridTemplateColumn Header="FECHA PRÉSTAMO / RETORNO" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Salida: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding FechaAsignacion, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Previsto: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding FechaDevProgramada, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='No definida'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Estado -->
                        <DataGridTemplateColumn Header="ESTADO" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2D2214"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Activo">
                                                        <Setter Property="Background" Value="#2D2214"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Devuelto">
                                                        <Setter Property="Background" Value="#172F1F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Perdido">
                                                        <Setter Property="Background" Value="#381717"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Estado}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Devuelto">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Perdido">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IndustrialPrimaryButton}"
                                            Content="↩️ Devolver"
                                            Padding="10,4"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.AbrirModalDevolucionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: NUEVO PRÉSTAMO DE HERRAMIENTA                 -->
        <!-- ═════════════════════════════════════════════════════════════ -->
        <Grid Background="#B3080B10"
              Visibility="{Binding MostrarModalNuevo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushGoldBright}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28">
                <StackPanel>
                    <!-- Header Modal -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="NUEVA ASIGNACIÓN / PRÉSTAMO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                            <TextBlock Text="Entrega de Herramienta a Personal" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Content="✕" FontSize="16" Cursor="Hand"
                                Command="{Binding CerrarModalNuevoCommand}"/>
                    </Grid>

                    <!-- Seleccionar Trabajador -->
                    <TextBlock Text="Trabajador Minero Responsable *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}"
                              ItemsSource="{Binding Empleados}"
                              SelectedItem="{Binding NuevoEmpleado}"
                              DisplayMemberPath="NombreCompleto"
                              Margin="0,0,0,16"/>

                    <!-- Seleccionar Herramienta -->
                    <TextBlock Text="Herramienta del Pañol *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}"
                              ItemsSource="{Binding Herramientas}"
                              SelectedItem="{Binding NuevaHerramienta}"
                              DisplayMemberPath="Nombre"
                              Margin="0,0,0,6"/>

                    <!-- Badge Stock Disponible -->
                    <Border Background="#16202B" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Stock Disponible para Préstamo: " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding StockDisponibleActual, StringFormat='{}{0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                        </StackPanel>
                    </Border>

                    <!-- Cantidad y Fecha Prevista -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cantidad a Prestar *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource IndustrialTextBox}" Text="{Binding NuevaCantidad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fecha Devolución Prevista" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding NuevaFechaDevolucion}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Observaciones -->
                    <TextBlock Text="Motivo de Uso / Observaciones de Salida" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource IndustrialTextBox}" 
                             Text="{Binding NuevasObservaciones, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,22"/>

                    <!-- Botones Acción -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IndustrialSecondaryButton}"
                                Content="Cancelar"
                                Command="{Binding CerrarModalNuevoCommand}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource IndustrialPrimaryButton}"
                                Content="Confirmar Préstamo"
                                Command="{Binding GuardarNuevoPrestamoCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: REGISTRAR DEVOLUCIÓN                          -->
        <!-- ═════════════════════════════════════════════════════════════ -->
        <Grid Background="#B3080B10"
              Visibility="{Binding MostrarModalDevolucion, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushGoldBright}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28">
                <StackPanel>
                    <!-- Header Modal -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="RECEPCIÓN EN PAÑOL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="Registrar Devolución de Herramienta" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Content="✕" FontSize="16" Cursor="Hand"
                                Command="{Binding CerrarModalDevolucionCommand}"/>
                    </Grid>

                    <!-- Resumen del Préstamo -->
                    <Border Background="#16202B" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding AsignacionADevolver.Herramienta.Nombre}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Trabajador: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding AsignacionADevolver.Empleado.NombreCompleto}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldBright}" Margin="0,0,12,0"/>
                                <TextBlock Text="Cant: " FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding AsignacionADevolver.Cantidad, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Selector Condición Retorno -->
                    <TextBlock Text="Estado Físico al Retornar *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}"
                              ItemsSource="{Binding Condiciones}"
                              SelectedItem="{Binding CondicionRetorno}"
                              Margin="0,0,0,16"/>

                    <!-- Observaciones de Inspección -->
                    <TextBlock Text="Observaciones de Inspección / Daños" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource IndustrialTextBox}" 
                             Text="{Binding ObservacionesDevolucion, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,22"/>

                    <!-- Botones Acción -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IndustrialSecondaryButton}"
                                Content="Cancelar"
                                Command="{Binding CerrarModalDevolucionCommand}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource IndustrialPrimaryButton}"
                                Content="Procesar Retorno a Pañol"
                                Command="{Binding ProcesarDevolucionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
