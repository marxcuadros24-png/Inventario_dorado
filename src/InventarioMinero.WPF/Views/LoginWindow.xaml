<Window x:Class="InventarioMinero.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:InventarioMinero.WPF.Helpers"
        xmlns:vm="clr-namespace:InventarioMinero.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Acceso al Sistema - Planta Minera Dorado S.A."
        Height="540" Width="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <!-- ── CONTENEDOR PRINCIPAL CON BORDE REDONDEADO Y SOMBRA ── -->
    <Border Background="{StaticResource BrushBgDeep}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" Opacity="0.6" ShadowDepth="12" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Panel izquierdo: Branding e identidad minera -->
                <ColumnDefinition Width="380"/>
                <!-- Panel derecho: Formulario de inicio de sesión -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- ── PANEL IZQUIERDO: BRANDING MINERO ── -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    CornerRadius="16,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18202A" Offset="0.0"/>
                        <GradientStop Color="#0F141B" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="36,36,36,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Izquierdo / Badge -->
                    <StackPanel Grid.Row="0">
                        <Border HorizontalAlignment="Left"
                                Background="{StaticResource BrushGoldSubtle}"
                                BorderBrush="{StaticResource BrushGoldBright}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,5"
                                Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushGoldBright}" Margin="0,0,8,0"/>
                                <TextBlock Text="SISTEMA CENTRAL LAN"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldBright}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Contenido Central: Logo y Títulos -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Icono Minero estilizado en vector XAML -->
                        <Border Width="80" Height="80"
                                Background="{StaticResource BrushGoldSubtle}"
                                BorderBrush="{StaticResource BrushGoldBright}"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20">
                            <Viewbox Width="44" Height="44">
                                <Canvas Width="24" Height="24">
                                    <!-- Pico y Cincel Minero estilizados -->
                                    <Path Fill="{StaticResource BrushGoldBright}"
                                          Data="M14.7,6.3L13.3,4.9C13,4.6,12.4,4.7,12.1,5.1L10.7,7L7,10.7C6.6,11.1,6.6,11.7,7,12.1l1.4,1.4l-6.7,6.7c-0.4,0.4-0.4,1,0,1.4l1.4,1.4c0.4,0.4,1,0.4,1.4,0l6.7-6.7l1.4,1.4c0.4,0.4,1,0.4,1.4,0l3.7-3.7l1.9-1.4c0.4-0.3,0.5-0.9,0.2-1.2L14.7,6.3z M20.7,2.3c-2.3-1.2-5.1-0.7-6.9,1.1l2.4,2.4l3.1-0.7l0.7-3.1C20.3,2.1,20.5,2.2,20.7,2.3z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="PLANTA MINERA"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSecondary}"/>

                        <TextBlock Text="DORADO S.A."
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushGoldBright}"
                                   Margin="0,2,0,12"/>

                        <TextBlock Text="Control Integral de Almacén, Herramientas, EPPs y Despacho en Mina"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="19"/>
                    </StackPanel>

                    <!-- Footer Izquierdo: Estado LAN -->
                    <StackPanel Grid.Row="2">
                        <Border Background="#121720"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                         Fill="{StaticResource BrushSuccess}"
                                         Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding EstadoServidor}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- ── PANEL DERECHO: FORMULARIO DE ACCESO ── -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Margin="44,24,44,28">
                <Grid.RowDefinitions>
                    <!-- Barra de título y botones minimizar/cerrar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Formulario de credenciales -->
                    <RowDefinition Height="*"/>
                    <!-- Footer con copyright -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra superior con botones de ventana -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,-24,0">
                    <Button Style="{StaticResource WindowChromeButtonStyle}"
                            Command="{Binding MinimizarCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Minimizar">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.5" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            Command="{Binding CerrarCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Cerrar">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.5" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Formulario central -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Iniciar Sesión"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Ingrese sus credenciales para acceder a la estación de trabajo"
                               FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,24"/>

                    <!-- Mensaje de Error (alerta dinámica) -->
                    <Border Background="#2D1515"
                            BorderBrush="{StaticResource BrushDanger}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensajeError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M13,17 L11,17 L11,15 L13,15 L13,17 Z M13,13 L11,13 L11,7 L13,7 L13,13 Z"
                                  Fill="{StaticResource BrushDanger}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MensajeError}"
                                       Foreground="#FF9999"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Campo: Usuario -->
                    <TextBlock Text="USUARIO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,18"/>

                    <!-- Campo: Contraseña -->
                    <TextBlock Text="CONTRASEÑA"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,8"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Style="{StaticResource DarkPasswordBoxStyle}"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="TxtPassword_KeyDown"
                                 Margin="0,0,0,16"/>

                    <!-- Opciones: Recordar usuario -->
                    <Grid Margin="0,0,0,24">
                        <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                  Content="Recordar mi usuario en esta terminal"
                                  IsChecked="{Binding RecordarUsuario}"
                                  HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Botón de Ingreso con indicador de carga -->
                    <Button Style="{StaticResource GoldPrimaryButtonStyle}"
                            Command="{Binding IniciarSesionCommand}"
                            Height="46">
                        <Grid>
                            <TextBlock Text="INGRESAR AL SISTEMA"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#1A1305"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Estado de carga -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Conectando y validando..."
                                           FontWeight="SemiBold"
                                           Foreground="#1A1305"
                                           FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Footer Derecho -->
                <TextBlock Grid.Row="2"
                           Text="Dorado S.A. © 2026 • Acceso seguro con encriptación BCrypt"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
